+    def test_explicitly_trusted_fake_ip_keeps_the_checked_connection(self):
+        config = {'base_url':'https://api.deepseek.com/v1', 'model':'deepseek-flash', 'key':'test-key'}
+        addresses = [(0, 0, 0, '', ('198.18.0.204', 443))]
+        connection = MagicMock()
+        response = connection.getresponse.return_value
+        response.status = 200
+        response.read.return_value = json.dumps({'choices':[{'message':{'content':'图中有绿色。'}}]}).encode()
+        response.getheader.return_value = 'test-request'
+        with patch.dict(os.environ, {'MURAL_FAKE_IP_HOSTS':'api.deepseek.com'}), \
+             patch('model_config.socket.getaddrinfo', return_value=addresses), \
+             patch('model_config.http.client.HTTPSConnection', return_value=connection) as https:
+            result, request_id = mc.request_model(config, [])
+        self.assertEqual(request_id, 'test-request')
+        self.assertTrue(result['choices'][0]['message']['content'])
+        self.assertEqual(https.call_args.args, ('api.deepseek.com', 443))
+        self.assertEqual(connection.request.call_args.args[:2], ('POST', '/v1/chat/completions'))
+        with patch('model_config.socket.create_connection') as connect:
+            connection._create_connection(('ignored.example', 443), 7)
+        connect.assert_called_once_with(('198.18.0.204', 443), 7, None)
+
+    def test_fake_ip_opt_in_does_not_allow_private_or_untrusted_destinations(self):
+        cases = [
+            ('api.deepseek.com', '198.18.0.204', ''),
+            ('other.example', '198.18.0.204', 'api.deepseek.com'),
+            ('api.deepseek.com', '127.0.0.1', 'api.deepseek.com'),
+            ('api.deepseek.com', '10.0.0.1', 'api.deepseek.com'),
+            ('api.deepseek.com', '::1', 'api.deepseek.com'),
+            ('api.deepseek.com', '169.254.169.254', 'api.deepseek.com'),
+        ]
+        for host, address, trusted in cases:
+            with self.subTest(host=host, address=address, trusted=trusted), \
+                 patch.dict(os.environ, {'MURAL_FAKE_IP_HOSTS':trusted}), \
+                 patch('model_config.socket.getaddrinfo', return_value=[(0, 0, 0, '', (address, 443))]), \
+                 patch('model_config.http.client.HTTPSConnection') as https:
+                with self.assertRaises(mc.ConfigError):
+                    mc.request_model({'base_url':'https://'+host+'/v1', 'model':'test', 'key':'test-key'}, [])
+                https.assert_not_called()
