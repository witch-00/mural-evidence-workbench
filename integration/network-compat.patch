@@ -93,7 +93,17 @@ def request_model(config, messages, max_tokens=250):
     u = urllib.parse.urlsplit(config['base_url'])
     try:
         addresses = {item[4][0] for item in socket.getaddrinfo(u.hostname, 443, type=socket.SOCK_STREAM)}
-        if not addresses or any(not ipaddress.ip_address(a).is_global for a in addresses):
+        # Local TUN proxies can resolve public domains into their 198.18/15 pool.
+        # Opt in by exact hostname; private/LAN destinations remain forbidden.
+        # TLS still verifies the original hostname and the checked IPs stay pinned.
+        fake_ip_hosts = {host.strip().lower() for host in
+                         os.environ.get('MURAL_FAKE_IP_HOSTS', '').split(',') if host.strip()}
+        fake_ip_allowed = (u.hostname or '').lower() in fake_ip_hosts
+        fake_ip_pool = ipaddress.ip_network('198.18.0.0/15')
+        def address_allowed(address):
+            ip = ipaddress.ip_address(address)
+            return ip.is_global or (fake_ip_allowed and ip in fake_ip_pool)
+        if not addresses or any(not address_allowed(a) for a in addresses):
             raise ConfigError('API 地址必须解析为公网地址。')
         body = {'model': config['model'], 'messages': messages, 'max_tokens': max_tokens}
         host = (u.hostname or '').lower()
